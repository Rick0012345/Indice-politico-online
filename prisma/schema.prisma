generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Politico {
  id             BigInt    @id @db.BigInt
  uri            String?   @db.Text
  cpf            String?   @unique @db.VarChar(11)
  nome           String
  nomeCivil      String?   @map("nome_civil")
  siglaPartido   String    @map("sigla_partido") @db.VarChar(50)
  siglaUf        String    @map("sigla_uf") @db.VarChar(2)
  idLegislatura  Int?      @map("id_legislatura") @db.SmallInt
  dataNascimento DateTime? @map("data_nascimento") @db.Date
  dataUltimoStatus DateTime? @map("data_ultimo_status") @db.Date
  sexo           String?   @db.VarChar(1)
  urlFoto        String?   @map("url_foto")
  nomeEleitoral  String?   @map("nome_eleitoral") @db.VarChar(255)
  condicaoEleitoral String? @map("condicao_eleitoral") @db.VarChar(100)
  email          String?   @db.VarChar(100)
  telefone       String?   @db.VarChar(50)
  urlWebsite     String?   @map("url_website") @db.Text
  redesSociais   String?   @map("redes_sociais") @db.Text
  escolaridade   String?   @db.VarChar(100)
  municipioNascimento String? @map("municipio_nascimento") @db.VarChar(100)
  ufNascimento   String?   @map("uf_nascimento") @db.VarChar(2)
  gabineteNome   String?   @map("gabinete_nome") @db.VarChar(50)
  gabinetePredio String?   @map("gabinete_predio") @db.VarChar(20)
  gabineteSala   String?   @map("gabinete_sala") @db.VarChar(20)
  gabineteAndar  String?   @map("gabinete_andar") @db.VarChar(20)
  situacao       String?   @default("Exercício") @db.VarChar(50)
  dataFalecimento DateTime? @map("data_falecimento") @db.Date
  uriPartido     String?   @map("uri_partido") @db.Text
  descricaoStatus String?  @map("descricao_status") @db.Text
  ultimoStatusJson Json?   @map("ultimo_status_json")
  rawJson        Json?     @map("raw_json")
  ativo          Boolean?  @default(true)
  atualizadoEm   DateTime? @default(now()) @map("atualizado_em") @db.Timestamptz(6)

  votos      VotoDeputado[]
  despesas   Despesa[]
  avaliacoes Avaliacao[]
  noticias   NoticiaPolitico[]
  judicialRecords JudicialRecord[]
  judicialCoverage JudicialCoverage?
  judicialAudit JudicialAudit[]
  judicialCandidates JudicialCandidate[]
  processObservations JudicialProcessObservation[]
  processAttempts JudicialProcessAttempt[]

  @@map("politicos")
}

model JudicialRecord {
  id String @id @db.Uuid
  politicoId BigInt @map("politico_id")
  kind String
  category String
  caseKey String @map("case_key")
  dedupeKey String @map("dedupe_key")
  verification String
  payload Json
  version Int @default(1)
  checkedAt DateTime? @map("checked_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  politico Politico @relation(fields:[politicoId],references:[id],onDelete:Restrict)
  audits JudicialAudit[]
  ingestionCandidates JudicialCandidate[]
  @@unique([politicoId,dedupeKey])
  @@map("judicial_records")
}

// Private ingestion evidence. Source versions are immutable; candidate links retain history.
model JudicialIngestionRun {
  id String @id @db.Uuid
  data Json
  lockPid Int? @map("lock_pid")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  evidence JudicialCandidateEvidence[]
  processAttempts JudicialProcessAttempt[]
  @@index([createdAt(sort:Desc)], map:"judicial_ingestion_runs_created_idx")
  @@map("judicial_ingestion_runs")
}
model JudicialProcessObservation {
  politicoId BigInt @map("politico_id")
  sourceId String @map("source_id")
  sourceKey String @map("source_key")
  canonicalKey String @map("canonical_key")
  identity String
  payload Json
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  politico Politico @relation(fields:[politicoId],references:[id],onDelete:Restrict)
  @@id([politicoId,sourceId,sourceKey])
  @@map("judicial_process_observations")
}
model JudicialProcessAttempt {
  runId String @map("run_id") @db.Uuid
  politicoId BigInt @map("politico_id")
  sourceId String @map("source_id")
  status String
  processedPages Int @default(0) @map("processed_pages")
  nominalMatches Int @default(0) @map("nominal_matches")
  errors Json @default("[]")
  truncated Boolean @default(false)
  startedAt DateTime @default(dbgenerated("clock_timestamp()")) @map("started_at") @db.Timestamptz(6)
  checkedAt DateTime? @map("checked_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  politico Politico @relation(fields:[politicoId],references:[id],onDelete:Restrict)
  run JudicialIngestionRun @relation(fields:[runId],references:[id],onDelete:Restrict)
  pages JudicialProcessPage[]
  @@id([runId,politicoId,sourceId])
  @@index([politicoId,startedAt(sort:Desc)],map:"judicial_process_attempts_person_idx")
  @@map("judicial_process_attempts")
}
model JudicialProcessPage {
  runId String @map("run_id") @db.Uuid
  politicoId BigInt @map("politico_id")
  sourceId String @default("STF_CASES") @map("source_id")
  page Int
  succeeded Boolean
  nominalMatches Int @map("nominal_matches")
  errors Json @default("[]")
  attempt JudicialProcessAttempt @relation(fields:[runId,politicoId,sourceId],references:[runId,politicoId,sourceId],onDelete:Restrict)
  @@id([runId,politicoId,sourceId,page])
  @@map("judicial_process_pages")
}
model JudicialSourceDocument {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  sourceId String @map("source_id")
  sourceKey String @map("source_key")
  contentHash String @map("content_hash")
  payload Json
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  candidates JudicialCandidate[]
  evidence JudicialCandidateEvidence[]
  @@unique([sourceId,sourceKey,contentHash])
  @@map("judicial_source_documents")
}
model JudicialCandidate {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicoId BigInt @map("politico_id")
  sourceId String @map("source_id")
  sourceKey String @map("source_key")
  documentId String @map("document_id") @db.Uuid
  matchedNames Json @default("[]") @map("matched_names")
  status String @default("PENDING")
  version Int @default(1)
  recordId String? @map("record_id") @db.Uuid
  contentChanged Boolean @default(false) @map("content_changed")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz(6)
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz(6)
  reviewNote String @default("") @map("review_note")
  politico Politico @relation(fields:[politicoId],references:[id],onDelete:Restrict)
  document JudicialSourceDocument @relation(fields:[documentId],references:[id],onDelete:Restrict)
  record JudicialRecord? @relation(fields:[recordId],references:[id],onDelete:Restrict)
  evidence JudicialCandidateEvidence[]
  @@unique([politicoId,sourceId,sourceKey])
  @@index([status,lastSeenAt(sort:Desc)],map:"judicial_candidates_review_idx")
  @@map("judicial_candidates")
}
model JudicialCandidateEvidence {
  candidateId String @map("candidate_id") @db.Uuid
  documentId String @map("document_id") @db.Uuid
  runId String @map("run_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  candidate JudicialCandidate @relation(fields:[candidateId],references:[id],onDelete:Restrict)
  document JudicialSourceDocument @relation(fields:[documentId],references:[id],onDelete:Restrict)
  run JudicialIngestionRun @relation(fields:[runId],references:[id],onDelete:Restrict)
  @@id([candidateId,documentId,runId])
  @@map("judicial_candidate_evidence")
}

model JudicialCoverage {
  politicoId BigInt @id @map("politico_id")
  status String
  scope String @default("")
  sources Json @default("[]")
  version Int @default(1)
  checkedAt DateTime? @map("checked_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)
  politico Politico @relation(fields:[politicoId],references:[id],onDelete:Restrict)
  @@map("judicial_coverage")
}

model JudicialAudit {
  id String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicoId BigInt @map("politico_id")
  recordId String? @map("record_id") @db.Uuid
  action String
  beforeData Json? @map("before_data")
  afterData Json @map("after_data")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  politico Politico @relation(fields:[politicoId],references:[id],onDelete:Restrict)
  record JudicialRecord? @relation(fields:[recordId],references:[id],onDelete:Restrict)
  @@index([politicoId,createdAt(sort:Desc)])
  @@map("judicial_audit")
}

model Votacao {
  id              String    @id
  uri             String?   @db.Text
  siglaTipo       String?   @map("sigla_tipo") @db.VarChar(20)
  numero          Int?
  ano             Int?
  ementa          String?   @db.Text
  data            DateTime? @db.Date
  dataHoraRegistro DateTime? @map("data_hora_registro") @db.Timestamptz(6)
  dataVotacao     DateTime? @map("data_hora_votacao") @db.Timestamptz(6)
  siglaOrgao      String?   @map("sigla_orgao") @db.VarChar(50)
  uriOrgao        String?   @map("uri_orgao") @db.Text
  idOrgao         Int?      @map("id_orgao")
  uriEvento       String?   @map("uri_evento") @db.Text
  idEvento        Int?      @map("id_evento")
  proposicaoObjeto String?  @map("proposicao_objeto") @db.Text
  uriProposicaoObjeto String? @map("uri_proposicao_objeto") @db.Text
  resultado       String?   @db.VarChar(255)
  aprovacao       Int?
  descUltimaAberturaVotacao String? @map("desc_ultima_abertura_votacao") @db.Text
  dataHoraUltimaAberturaVotacao DateTime? @map("data_hora_ultima_abertura_votacao") @db.Timestamptz(6)
  ultimaApresentacaoProposicaoJson Json? @map("ultima_apresentacao_proposicao_json")
  efeitosRegistradosJson Json? @map("efeitos_registrados_json")
  objetosPossiveisJson Json? @map("objetos_possiveis_json")
  tipoVotacao     String    @map("tipo_votacao") @db.VarChar(30)
  ehSubvotacao    Boolean   @map("eh_subvotacao")
  tituloPublico   String    @map("titulo_publico") @db.Text
  resumoLeigo     String?   @map("resumo_leigo") @db.Text
  classificacaoFonte String  @map("classificacao_fonte") @db.VarChar(30)
  classificacaoConfianca String @map("classificacao_confianca") @db.VarChar(20)
  classificacaoVersao String @map("classificacao_versao") @db.VarChar(40)
  classificacaoJustificativa String? @map("classificacao_justificativa") @db.Text
  aiInputHash     String?   @map("ai_input_hash") @db.VarChar(64)
  aiModel         String?   @map("ai_model") @db.VarChar(120)
  aiPromptVersao  String?   @map("ai_prompt_versao") @db.VarChar(40)
  aiGeradoEm      DateTime? @map("ai_gerado_em") @db.Timestamptz(6)
  rawJson         Json?     @map("raw_json")

  votos VotoDeputado[]
  objetosPossiveis VotacaoObjetoPossivel[]
  proposicoesAfetadas VotacaoProposicaoAfetada[]

  @@map("votacoes")
}

model VotacaoObjetoPossivel {
  votacaoId    String   @map("votacao_id")
  proposicaoId BigInt   @map("proposicao_id") @db.BigInt
  uri           String?  @db.Text
  siglaTipo     String?  @map("sigla_tipo") @db.VarChar(30)
  numero        Int?
  ano           Int?
  ementa        String?  @db.Text
  ordem         Int      @default(0)
  rawJson       Json     @map("raw_json")
  atualizadoEm  DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  votacao       Votacao  @relation(fields: [votacaoId], references: [id], onDelete: Cascade)

  @@id([votacaoId, proposicaoId])
  @@map("votacao_objetos_possiveis")
}

model VotacaoProposicaoAfetada {
  votacaoId    String   @map("votacao_id")
  proposicaoId BigInt   @map("proposicao_id") @db.BigInt
  uri           String?  @db.Text
  siglaTipo     String?  @map("sigla_tipo") @db.VarChar(30)
  numero        Int?
  ano           Int?
  ementa        String?  @db.Text
  efeito        String?  @db.Text
  ordem         Int      @default(0)
  rawJson       Json     @map("raw_json")
  atualizadoEm  DateTime @default(now()) @map("atualizado_em") @db.Timestamptz(6)
  votacao       Votacao  @relation(fields: [votacaoId], references: [id], onDelete: Cascade)

  @@id([votacaoId, proposicaoId])
  @@map("votacao_proposicoes_afetadas")
}

model VotoDeputado {
  id        String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  votacaoId String @map("votacao_id")
  politicoId BigInt @map("politico_id") @db.BigInt
  voto      String @db.VarChar(50)
  dataHoraVoto DateTime? @map("data_hora_voto") @db.Timestamptz(6)
  deputadoJson Json? @map("deputado_json")
  rawJson   Json? @map("raw_json")

  votacao  Votacao  @relation(fields: [votacaoId], references: [id], onDelete: Cascade)
  politico Politico @relation(fields: [politicoId], references: [id], onDelete: Cascade)

  @@unique([votacaoId, politicoId])
  @@index([votacaoId])
  @@index([politicoId])
  @@map("votos_deputados")
}

model Despesa {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicoId        BigInt    @map("politico_id") @db.BigInt
  ano               Int       @db.SmallInt
  mes               Int       @db.SmallInt
  tipoDespesa       String    @map("tipo_despesa") @db.VarChar(255)
  codDocumento      String?   @map("cod_documento") @db.VarChar(100)
  // Partial unique identity for cod_documento IS NULL is managed by the SQL migration.
  identidadeOrigem  String?   @map("identidade_origem") @db.VarChar(100)
  cnpjCpfFornecedor String?   @map("cnpj_cpf_fornecedor") @db.VarChar(14)
  nomeFornecedor    String?   @map("nome_fornecedor") @db.VarChar(255)
  tipoDocumento     String?   @map("tipo_documento") @db.VarChar(50)
  codTipoDocumento  Int?      @map("cod_tipo_documento")
  dataDocumento     DateTime? @map("data_documento") @db.Date
  numDocumento      String?   @map("num_documento") @db.VarChar(100)
  valorDocumento    Decimal   @map("valor_documento") @db.Decimal(12, 2)
  valorGlosa        Decimal?  @default(0) @map("valor_glosa") @db.Decimal(12, 2)
  valorLiquido      Decimal   @map("valor_liquido") @db.Decimal(12, 2)
  numLote           String?   @map("num_lote") @db.VarChar(50)
  codLote           String?   @map("cod_lote") @db.VarChar(100)
  numRessarcimento  String?   @map("num_ressarcimento") @db.VarChar(50)
  parcela           Int?      @default(0) @db.SmallInt
  urlDocumento      String?   @map("url_documento") @db.Text
  rawJson           Json?     @map("raw_json")

  politico Politico @relation(fields: [politicoId], references: [id], onDelete: Cascade)

  @@index([politicoId], map: "idx_despesas_politico")
  @@index([cnpjCpfFornecedor], map: "idx_despesas_fornecedor")
  @@index([ano, mes], map: "idx_despesas_data_competencia")
  @@unique([politicoId, ano, mes, codDocumento, tipoDespesa], map: "despesas_politico_competencia_documento_tipo_key")
  @@map("despesas")
}

model Avaliacao {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicoId    BigInt   @map("politico_id") @db.BigInt
  cpfHash       String   @map("cpf_hash") @db.VarChar(255)
  nota          Int      @db.SmallInt
  comentario    String?  @db.Text
  dataAvaliacao DateTime? @default(now()) @map("data_avaliacao") @db.Timestamptz(6)

  politico Politico @relation(fields: [politicoId], references: [id], onDelete: Cascade)

  @@unique([politicoId, cpfHash])
  @@index([politicoId], map: "idx_avaliacoes_politico")
  @@map("avaliacoes")
}

model NoticiaPolitico {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  politicoId     BigInt    @map("politico_id") @db.BigInt
  titulo         String    @db.Text
  resumo         String?   @db.Text
  url            String    @db.Text
  veiculo        String?   @db.VarChar(255)
  dominio        String?   @db.VarChar(255)
  dataPublicacao DateTime? @map("data_publicacao") @db.Timestamptz(6)
  imagemUrl      String?   @map("imagem_url") @db.Text
  idioma         String?   @db.VarChar(20)
  paisOrigem     String?   @map("pais_origem") @db.VarChar(10)
  fonteColeta    String    @default("gdelt_doc_2") @map("fonte_coleta") @db.VarChar(50)
  periodoTipo    String?   @map("periodo_tipo") @db.VarChar(20)
  janelaConsulta String?   @map("janela_consulta") @db.VarChar(20)
  queryUsada     String?   @map("query_usada") @db.Text
  criadoEm       DateTime? @default(now()) @map("criado_em") @db.Timestamptz(6)
  atualizadoEm   DateTime? @updatedAt @map("atualizado_em") @db.Timestamptz(6)

  politico Politico @relation(fields: [politicoId], references: [id], onDelete: Cascade)

  @@unique([politicoId, url])
  @@index([politicoId], map: "idx_noticias_politico")
  @@index([dataPublicacao], map: "idx_noticias_data_publicacao")
  @@index([periodoTipo], map: "idx_noticias_periodo_tipo")
  @@map("noticias_politicos")
}

model CamaraApiRawItem {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  resource       String   @db.VarChar(120)
  resourceId     String   @map("resource_id") @db.Text
  parentResource String   @default("") @map("parent_resource") @db.VarChar(120)
  parentId       String   @default("") @map("parent_id") @db.Text
  endpoint       String   @db.Text
  queryParams    Json     @default("{}") @map("query_params")
  rawJson        Json     @map("raw_json")
  linksJson      Json?    @map("links_json")
  fetchedAt      DateTime @default(now()) @map("fetched_at") @db.Timestamptz(6)
  updatedAt      DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([resource, resourceId, parentResource, parentId])
  @@index([resource], map: "idx_camara_api_raw_items_resource")
  @@index([parentResource, parentId], map: "idx_camara_api_raw_items_parent")
  @@map("camara_api_raw_items")
}
