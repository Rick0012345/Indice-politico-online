# Copie este arquivo para .env. Nunca envie o .env real ao Git.
ADMIN_API_TOKEN=troque-por-um-token-administrativo-forte

# Crie uma chave nova no painel da Groq. Chaves com prefixo gsk_ são segredos.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# Porta local opcional do n8n.
N8N_HOST_PORT=5679
N8N_ENCRYPTION_KEY=troque-por-uma-chave-de-criptografia-forte
